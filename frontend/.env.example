# ─── TradVue Frontend — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it's in .gitignore.

# Backend API URL (local dev default shown). Also used at build time for
# Content-Security-Policy connect-src — Preview/staging must set this to the
# staging API so the browser is allowed to call it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Analytics 4 Measurement ID
# Get this from: Google Analytics → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
# Leave blank to disable analytics (also disabled automatically in dev/local builds)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Legacy alias (still works, new key takes priority)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
